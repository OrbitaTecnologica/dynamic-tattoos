{
    "name": "dynamic-tattoos/platform",
    "description": "A SaaS platform that links permanent QR code tattoos to user-controlled multimedia pages.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.51",
        "laravel/tinker": "^2.9",
        "livewire/livewire": "^3.0",
        "simplesoftwareio/simple-qrcode": "^4.2"
    },
    "require-dev": {
        "laravel/breeze": "^2.4",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php -r \"if (file_exists('artisan')) { passthru(PHP_BINARY . ' artisan package:discover --ansi'); }\""
        ],
        "post-update-cmd": [
            "@php -r \"if (file_exists('artisan')) { passthru(PHP_BINARY . ' artisan vendor:publish --tag=laravel-assets --ansi --force'); }\""
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php -r \"if (file_exists('artisan')) { passthru(PHP_BINARY . ' artisan key:generate --ansi'); }\""
        ]
    },
    "config": {
        "sort-packages": true
    }
}
