# =============================================================================
# APPLICATION
# Ejecutar: php artisan key:generate
# =============================================================================
APP_NAME="Dynamic Tattoos"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_TIMEZONE=UTC
APP_LOCALE=es
APP_FALLBACK_LOCALE=en

# =============================================================================
# DATABASE — MySQL 8.4
# =============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dynamic_tattoos
DB_USERNAME=
DB_PASSWORD=

# =============================================================================
# CACHE
# Opciones: file | redis | database
# En producción usar redis para invalidar tattoo_content_{shortCode} de forma
# atómica entre múltiples instancias del servidor.
# =============================================================================
CACHE_STORE=file
CACHE_PREFIX=dynamic_tattoos

# =============================================================================
# SESSION
# =============================================================================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# =============================================================================
# QUEUE
# =============================================================================
QUEUE_CONNECTION=database

# =============================================================================
# STRIPE
# =============================================================================
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE=300

# =============================================================================
# CLOUDFLARE TURNSTILE (CAPTCHA)
# =============================================================================
TURNSTILE_SECRET_KEY=

# =============================================================================
# REDIS (activar si CACHE_STORE=redis o QUEUE_CONNECTION=redis)
# =============================================================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0

# =============================================================================
# MAIL
# Desarrollo: 'log' escribe los correos al log sin enviarlos.
# Producción: configurar 'smtp' con las credenciales del proveedor.
# =============================================================================
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@dynamictattoos.com"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
# FILESYSTEM / STORAGE
# Desarrollo : FILESYSTEM_DISK=local + php artisan storage:link
# Producción : FILESYSTEM_DISK=s3 + completar variables AWS_* abajo
# =============================================================================
FILESYSTEM_DISK=local

# S3 / Compatible (Cloudflare R2, MinIO, etc.) — sólo necesario en producción
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =============================================================================
# VITE / FRONTEND
# =============================================================================
VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# LOGGING
# Producción: cambiar LOG_LEVEL a 'error' o 'warning'
# =============================================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null
API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8001,http://127.0.0.1:8001,http://localhost:8000,http://127.0.0.1:8000
